# Copy to .env.local (web) or .env (mobile) and fill in. Never commit real values.
# Real keys are stored in the hosting provider's secret store, not in this repository.

# Supabase (dev, staging and production projects are separate)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Server-only. Never expose this in the mobile app or the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# PowerSync (added in Phase 5)
POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# SMS provider (chosen in decision D-001)
SMS_PROVIDER_API_KEY=your-sms-key-placeholder
SMS_SENDER_NAME=MitraLink
